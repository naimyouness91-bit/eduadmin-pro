# =============================================================================
# EduAdmin Pro — Monorepo .gitignore
#
#   EduAdmin-Pro/   Backend  — Laravel 10 (PHP 8.2)
#   frontend/       Frontend — React 18 + Vite 5
#   docs/           Documentation
#
# This file holds the rules that apply to the WHOLE repository.
# Project-specific rules live next to the code they protect:
#   EduAdmin-Pro/.gitignore  +  storage/**/.gitignore  (Laravel)
#   frontend/.gitignore
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets / environment
# Real .env files contain APP_KEY, database credentials and API keys: never
# committed. The templates (.env.example) stay tracked on purpose.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example


# -----------------------------------------------------------------------------
# Dependencies
# Covers the root node_modules/ (stray Playwright install) and every nested one.
# -----------------------------------------------------------------------------
node_modules/


# -----------------------------------------------------------------------------
# Build output
# frontend/dist/ is generated by `npm run build`.
# -----------------------------------------------------------------------------
dist/
dist-ssr/
build/


# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# -----------------------------------------------------------------------------
# Local databases and database dumps
# The project targets MySQL; nothing here should ever be versioned.
# -----------------------------------------------------------------------------
*.sql
*.sqlite
*.sqlite3
*.db


# -----------------------------------------------------------------------------
# Archives and backups
# e.g. storage/framework/testing/disks/backups/*.zip produced by the test suite
# -----------------------------------------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.bak


# -----------------------------------------------------------------------------
# Test and tooling caches
# .phpunit.result.cache is written by PHPUnit on every run.
# -----------------------------------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpstan.cache/
coverage/


# -----------------------------------------------------------------------------
# Encryption keys, certificates and credentials
# -----------------------------------------------------------------------------
*.key
*.pem
*.p12
*.pfx
*.crt
auth.json
Homestead.json
Homestead.yaml


# -----------------------------------------------------------------------------
# Uploaded user files (defence in depth)
# storage/app/.gitignore already ignores its whole content; these rules keep
# user uploads out even if that file is ever removed.
# -----------------------------------------------------------------------------
storage/app/course-quiz-documents/
storage/app/public/
storage/framework/testing/disks/


# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.idea/
.vscode/
.fleet/
*.swp
*.swo
*~
.\#*
\#*\#


# -----------------------------------------------------------------------------
# Operating system
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk