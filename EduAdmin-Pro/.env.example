# =============================================================================
# EduAdmin Pro — Laravel API (.env.example)
# Copy to .env and adjust values for your environment.
# =============================================================================

# --- Application ---
APP_NAME="EduAdmin Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8888

# --- Logging ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eduadmin_pro
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / Queue / Session ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Redis (optional) ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Memcached (optional: only when CACHE_DRIVER=memcached) ---
MEMCACHED_HOST=127.0.0.1

# --- Mail (password reset, notifications) ---
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@eduadmin.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS S3 (optional file storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Laravel Sanctum (SPA auth from http://localhost:5173) ---
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# --- React SPA dev server ---
# Base URL of the Vite dev server. Used by routes/web.php to redirect /login
# when public/index.html is not present. Must match frontend/.env
# (VITE_DEV_API_PROXY points at APP_URL, not at this URL).
FRONTEND_URL=http://127.0.0.1:5173

# CORS is configured in config/cors.php (allowed_origins: http://localhost:5173)

# --- AI (OpenAI-compatible: OpenAI, Azure OpenAI, GitHub Models) ---
# Required for AI Quiz generation and recommended for AI Study / Exam Prep quality.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120
# Optional: custom endpoint (Azure OpenAI, GitHub Models, local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=

# --- Virtual meetings (Jitsi Meet — public meet.jit.si by default) ---
JITSI_DOMAIN=meet.jit.si

# --- Frontend build (if using Laravel Vite integration) ---
VITE_APP_NAME="${APP_NAME}"
