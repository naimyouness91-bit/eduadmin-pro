# =============================================================================
# EduAdmin Pro — React frontend (.env.example)
# Copy to .env for local development.
# =============================================================================

# API base URL
# Dev with Vite: use /api (proxied to Laravel — see VITE_DEV_API_PROXY)
# Production / no proxy: use full URL, e.g. http://127.0.0.1:8888/api
VITE_API_URL=/api

# Laravel dev server URL (must match `php artisan serve` port)
# EduAdmin-Pro/.env uses APP_URL=http://127.0.0.1:8888
VITE_DEV_API_PROXY=http://127.0.0.1:8888
